        "h": 10,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 1,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "awg_peer_online{peer=~\"$peer\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "awg_peer_handshake_age_seconds{peer=~\"$peer\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(awg_peer_endpoint_changed_total{peer=~\"$peer\"}[1h])",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_duration_seconds{job=\"blackbox_icmp_peers\", peer=~\"$peer\"} * 1000",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg_over_time(probe_success{job=\"blackbox_icmp_peers\", peer=~\"$peer\"}[5m]))",
          "instant": true,
          "format": "table"
        }
      ],
