global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]

  - job_name: node
    static_configs:
      - targets: ["{{ node_exporter_listen_ip }}:{{ node_exporter_port }}"]

  - job_name: amneziawg
    static_configs:
      - targets: ["{{ amneziawg_exporter_listen_ip }}:{{ amneziawg_exporter_port }}"]
